{
  "marketplace": "tokenmaxxxer-execution-observation",
  "repo": "tokenmaxxxer/execution-observation-rulebook",
  "path": "$TOKENMAXXXER_RULEBOOKS/execution-observation-rulebook",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.github.com",
        "github.com"
      ]
    }
  },
  "decides": "실행 시 실제 동작",
  "use_when": "실행 가능한 산출물이 랜딩됐을 때. 실행 없는 판정 금지, 고치지 않음 (board_condition: an executable artifact landed on the branch AND no execution-observation record exists yet for this commit sha)",
  "produces": "증거 인용된 claim별 pass/fail/blocked, run command/log reference, 버그 리포트(레코드로; 이슈는 사용자가)",
  "write_scope": ["docs/issue-<n>/reports/execution-observation.md"],
  "spec": "roles/specs/execution-observation.spec.json",
  "record_fields": {
    "loop_state": {
      "progress": ["running", "collecting-evidence"],
      "terminal": ["handed-off"],
      "refusal": ["execution-not-possible"],
      "error": ["environment-setup-failed"]
    }
  }
}
