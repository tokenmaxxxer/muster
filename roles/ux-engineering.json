{
  "marketplace": "tokenmaxxxer-ux-engineering",
  "repo": "tokenmaxxxer/ux-engineering-rulebook",
  "path": "$TOKENMAXXXER_RULEBOOKS/ux-engineering-rulebook",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.github.com",
        "github.com"
      ]
    }
  },
  "decides": "디자인 결정 → 토큰/규칙 시스템화",
  "use_when": "화면 스펙이 여러 개 쌓여 시스템화가 필요할 때",
  "produces": "token set (name/value/usage), rule doc, migration note for existing screens",
  "write_scope": [],
  "record_fields": {
    "loop_state": ["landed"]
  }
}
