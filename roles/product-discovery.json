{
  "marketplace": "tokenmaxxxer-product-discovery",
  "repo": "tokenmaxxxer/product-discovery-rulebook",
  "path": "$TOKENMAXXXER_RULEBOOKS/product-discovery-rulebook",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.github.com",
        "github.com"
      ]
    }
  },
  "decides": "무엇을 만들지 — 가치 가설 (Cagan discovery)",
  "use_when": "요구가 아직 문제/가설 수준일 때. 사전등록 가설(지표·임계값·결정규칙)로 스펙 또는 kill 기록을 만든다",
  "produces": "hypothesis statement, target user/JTBD, evidence log, confidence level, next-decision trigger, product record",
  "write_scope": [],
  "record_fields": {
    "loop_state": ["measuring"]
  }
}
