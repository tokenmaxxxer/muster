{
  "marketplace": "tokenmaxxxer-verify",
  "repo": "tokenmaxxxer/verify-agent-rulebook",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.github.com",
        "github.com"
      ]
    }
  },
  "decides": "결함이 실재하는가 — 독립 재현으로",
  "use_when": "결과를 직접 관찰(qa)이나 명세 대조(review)만으로 결론낼 수 없을 때 — 재현이 어렵거나 다투는 실행 결과 주장, 복잡한 변경. coding·qa·review 가 놓친 것을 적대적 독립 재현으로 찾는다",
  "produces": "attempt별 reproduced|not-reproduced + 증거, blocking|advisory finding",
  "record_fields": {
    "loop_state": ["cleared"]
  }
}
