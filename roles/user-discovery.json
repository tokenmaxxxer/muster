{
  "marketplace": "tokenmaxxxer-user-discovery",
  "repo": "tokenmaxxxer/user-discovery-rulebook",
  "path": "$TOKENMAXXXER_RULEBOOKS/user-discovery-rulebook",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.github.com",
        "github.com"
      ]
    }
  },
  "decides": "이 문제가 실제 사용자의 고통인가",
  "use_when": "가설 검증을 위해 사용자 인터뷰가 필요할 때",
  "produces": "interview script, per-interview evidence log, pain-confirmed|not-confirmed verdict",
  "write_scope": [],
  "record_fields": {
    "loop_state": [
      "landed"
    ]
  }
}
