{
  "marketplace": "tokenmaxxxer-review",
  "repo": "tokenmaxxxer/review-agent-rulebook",
  "path": "$TOKENMAXXXER_RULEBOOKS/review-agent-rulebook",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.github.com",
        "github.com"
      ]
    }
  },
  "decides": "만들어진 것이 명세와 일치하는가",
  "use_when": "coding 커밋이 랜딩됐고 요구사항 대비 감사가 필요할 때. 빌더 의도는 안 읽는다",
  "produces": "요구사항별 Present|Surface|Absent|Incorrect|Unverifiable",
  "write_scope": [],
  "record_fields": {
    "loop_state": ["reported"]
  }
}
