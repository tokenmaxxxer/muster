{
  "marketplace": "tokenmaxxxer-qa",
  "repo": "tokenmaxxxer/qa-agent-rulebook",
  "path": "$TOKENMAXXXER_RULEBOOKS/qa-agent-rulebook",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.github.com",
        "github.com"
      ]
    }
  },
  "decides": "실행했을 때 실제로 어떻게 동작하는가",
  "use_when": "실행 가능한 산출물이 랜딩됐을 때. 실행 없는 판정 금지, 고치지 않음",
  "produces": "증거 인용된 pass/fail/blocked, 버그 리포트(레코드로; 이슈는 사용자가)"
}
