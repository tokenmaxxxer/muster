{
  "marketplace": "tokenmaxxxer-coding",
  "repo": "tokenmaxxxer/coding-agent-rulebook",
  "path": "$TOKENMAXXXER_RULEBOOKS/coding-agent-rulebook",
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "*.github.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "github.com"
      ]
    }
  },
  "decides": "승인된 범위를 동작하는 코드로",
  "use_when": "스펙/제안이 승인됐고 구현이 필요할 때. 검증은 안 한다 — 자기 주장 확인(빌드·자기 테스트 1회)까지만",
  "produces": "src/·test/ 코드, build proposal, coding record"
}
