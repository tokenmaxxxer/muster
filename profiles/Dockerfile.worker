# 워커 이미지 하나. 프로파일 차이(reader/builder/prober)는 이미지가 아니라
# 마운트·네트워크·주입 env 로 낸다 — 이미지를 셋으로 늘릴 이유가 없다.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates python3 curl \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code && npm cache clean --force

# 루트로 돌지 않는다. uid 는 호스트 마운트 쓰기 권한 때문에 런타임에 맞춘다.
RUN useradd -m -u 1001 worker
USER worker
WORKDIR /work

# 계약: /work 에서 작업하고 산출물은 /out 에 쓴다. 그 밖의 경로는 없다.
ENV HOME=/home/worker
